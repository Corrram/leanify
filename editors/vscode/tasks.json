{
  // Leanify: check a LaTeX article while you write it.
  // Copy into your project's .vscode/tasks.json and adjust the inputs below.
  //
  // "Leanify: quick check" runs the compiler natively on the open .tex file
  // (about a second): undefined symbols, sentences the grammar cannot read, and
  // with --claims the formal reading of every claim. Nothing is certified.
  //
  // "Leanify: certify" updates the article's pin in the Lean file with
  // #leanify_article (so that Lake recompiles the edited article), builds the
  // module with #leanify_certify, and reports every claim that is not verified.
  //
  // Findings appear as squiggles in the .tex file and in the Problems panel.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Leanify: quick check",
      "type": "shell",
      "command": "lake exe leanify check ${file} --vocab ${input:vocab} --prose",
      "group": "build",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": [
        {
          "owner": "leanify",
          "source": "Leanify",
          "fileLocation": ["autoDetect", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(.+\\.tex):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
          }
        }
      ]
    },
    {
      "label": "Leanify: certify",
      "type": "shell",
      "command": "python .lake/packages/leanify/scripts/leanify_diagnostics.py ${input:report} --pin ${input:compiledFile} && lake build ${input:certifyModule} && python .lake/packages/leanify/scripts/leanify_diagnostics.py ${input:report} --prose",
      "group": "build",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": [
        {
          "owner": "leanify",
          "source": "Leanify",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(.+\\.tex):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
          }
        },
        {
          "owner": "lean",
          "source": "Lean",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(?:error|warning): (.+\\.lean):(\\d+):(\\d+): (.*)$",
            "file": 1, "line": 2, "column": 3, "message": 4
          }
        }
      ]
    }
  ],
  "inputs": [
    { "id": "vocab", "type": "promptString", "description": "Vocabulary for the quick check (core or unitsquare)",
      "default": "unitsquare" },
    { "id": "certifyModule", "type": "promptString", "description": "Lean module with #leanify_certify",
      "default": "Papers.Rockel2026ExactBlest.Source.Certified" },
    { "id": "compiledFile", "type": "promptString", "description": "Lean file with #leanify_article",
      "default": "Papers/Rockel2026ExactBlest/Source/Compiled.lean" },
    { "id": "report", "type": "promptString", "description": "The article's .leanify.json",
      "default": "Papers/Rockel2026ExactBlest/Source/article.leanify.json" }
  ]
}
