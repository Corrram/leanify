import Leanify.Library.Core

/-! # Vocabulary: finite groups

A group is a finite group (a group structure on `Fin n`, for some `n ≥ 1`): a type of its
own, so that an article binds groups as it binds numbers (`Let $G$ be a group of order
$n$.`, `every abelian group $G$`) and speaks of them up to isomorphism (`$G$ is isomorphic
to the cyclic group of order $4$`).

* nouns: `group`, `finite group`;
* adjectives: `abelian`, `commutative`, `cyclic`, `simple`, `solvable`, `nilpotent`,
  `trivial`, `nontrivial`, `of order $n$`, `isomorphic to $H$`, `$p$-group`;
* notions: the order, the exponent, the numbers of subgroups, of normal subgroups, of
  conjugacy classes, of elements of a given order and of Sylow `p`-subgroups, the order of
  the centre; the cyclic, symmetric, alternating and dihedral groups, the Klein
  four-group, the trivial group, and the direct product of two groups.

Equality of groups is equality of the group structures; `isomorphic to` is what an article
means. The constants are interpreted by `Leanify/Library/GroupsModel.lean`. -/

namespace Leanify.Groups
open Build Core

/-- Finite groups: the field's base type. -/
abbrev G : Ty := .base 0

/-- The constants, in the order of their indices: `(type, TeX name, Lean name)`. -/
def table : List (Ty × Codes × Codes) := [
  (G ⟶ .real, w!"\\lvert #\\rvert", w!"Leanify.Groups.order"),                           -- 0
  (G ⟶ .prop, w!"\\operatorname{Abelian}", w!"Leanify.Groups.Abelian"),                  -- 1
  (G ⟶ .prop, w!"\\operatorname{Cyclic}", w!"Leanify.Groups.Cyclic"),                    -- 2
  (G ⟶ .prop, w!"\\operatorname{Simple}", w!"Leanify.Groups.Simple"),                    -- 3
  (G ⟶ .prop, w!"\\operatorname{Solvable}", w!"Leanify.Groups.Solvable"),                -- 4
  (G ⟶ .prop, w!"\\operatorname{Nilpotent}", w!"Leanify.Groups.Nilpotent"),              -- 5
  (G ⟶ G ⟶ .prop, w!"#1\\cong #2", w!"Leanify.Groups.Isomorphic"),                       -- 6
  (.real ⟶ G ⟶ .prop, w!"\\operatorname{IsPGroup}", w!"Leanify.Groups.PGroup"),          -- 7
  (G ⟶ .real, w!"\\exp", w!"Leanify.Groups.exponent"),                                   -- 8
  (G ⟶ .real, w!"\\operatorname{\\#Sub}", w!"Leanify.Groups.numSubgroups"),              -- 9
  (G ⟶ .real, w!"\\operatorname{\\#NSub}", w!"Leanify.Groups.numNormalSubgroups"),       -- 10
  (G ⟶ .real, w!"k", w!"Leanify.Groups.numConjClasses"),                                 -- 11
  (.real ⟶ G ⟶ .real, w!"\\operatorname{\\#ord}_{#1}(#2)", w!"Leanify.Groups.numOfOrder"), -- 12
  (.real ⟶ G ⟶ .real, w!"n_{#1}(#2)", w!"Leanify.Groups.numSylow"),                      -- 13
  (G ⟶ .real, w!"\\lvert Z(#)\\rvert", w!"Leanify.Groups.centerOrder"),                  -- 14
  (.real ⟶ G, w!"C_{#}", w!"Leanify.Groups.cyclic"),                                     -- 15
  (.real ⟶ G, w!"S_{#}", w!"Leanify.Groups.symmetric"),                                  -- 16
  (.real ⟶ G, w!"A_{#}", w!"Leanify.Groups.alternating"),                                -- 17
  (.real ⟶ G, w!"D_{#}", w!"Leanify.Groups.dihedral"),                                   -- 18
  (G, w!"V_4", w!"Leanify.Groups.kleinFour"),                                            -- 19
  (G, w!"1", w!"Leanify.Groups.trivial"),                                                -- 20
  (G ⟶ G ⟶ G, w!"\\times", w!"Leanify.Groups.prod")]                                     -- 21

def gPred (p : B → B) : Tm := close <| lamT G (fun _ => tt) p
def ord (g : B) : B := app (const 0) g
def ofG (name : Phrase) (c : Nat) (doc : String) : Notion := { name, value := .const c, ty := G ⟶ .real, doc }
def mod (p : Phrase) (pre : Bool) (pred : Tm) (doc : String) : Modifier :=
  { phrase := p, prenominal := pre, ty := G, pred, doc }
def onN (name : Phrase) (c : Nat) (dom : Tm) (doc : String) : Notion :=
  { name, value := .const c, ty := .real ⟶ G, doms := [some dom], doc }
def iso : Tm := close <| lamT G (fun _ => tt) fun h => lamT G (fun _ => tt) fun g => app2 (const 6) g h

def vocab : Vocab where
  types := [w!"\\mathrm{Grp}"]
  consts := table.map (·.1)
  constNames := table.map (·.2.1)
  constLean := table.map (·.2.2)
  typeLean := [(w!"Leanify.Groups.Grp", w!"Leanify.Groups.trivial")]
  modules := [w!"Leanify.Library.GroupsModel"]
  nouns := [
    { sing := phrase!"group", plural := phrase!"groups", ty := G, pred := gPred fun _ => tt,
      doc := "a finite group (Mathlib `Group (Fin n)`)" },
    { sing := phrase!"finite group", plural := phrase!"finite groups", ty := G, pred := gPred fun _ => tt,
      doc := "(Mathlib `Group (Fin n)`)" }]
  mods := [
    mod phrase!"abelian" true (.const 1) "`ab = ba` (Mathlib `CommGroup`)",
    mod phrase!"commutative" true (.const 1) "`ab = ba`",
    mod phrase!"cyclic" true (.const 2) "generated by one element (Mathlib `IsCyclic`)",
    mod phrase!"simple" true (.const 3) "nontrivial, without proper normal subgroups (Mathlib `IsSimpleGroup`)",
    mod phrase!"solvable" true (.const 4) "(Mathlib `IsSolvable`)",
    mod phrase!"nilpotent" true (.const 5) "(Mathlib `Group.IsNilpotent`)",
    mod phrase!"trivial" true (gPred fun g => eq (ord g) (num 1)) "of order 1",
    mod phrase!"nontrivial" true (gPred fun g => lt (num 1) (ord g)) "of order at least 2",
    mod phrase!"of order $v$" false (close <| lamR fun n => lamT G (fun _ => tt) fun g => eq (ord g) n) "with `n` elements",
    mod phrase!"isomorphic to $v$" false iso "(Mathlib `MulEquiv`)",
    mod phrase!"$v$-group" false (close <| lamR fun p => lamT G (fun _ => tt) fun g =>
        and (app (lift Core.posInt) p) (app2 (const 7) p g)) "every element has order a power of `p` (Mathlib `IsPGroup`)"]
  notions := [
    ofG phrase!"order of $v$" 0 "the number of elements (Mathlib `Nat.card`)",
    ofG phrase!"exponent of $v$" 8 "the least `e ≥ 1` with `g^e = 1` for all `g` (Mathlib `Monoid.exponent`)",
    ofG phrase!"number of subgroups of $v$" 9 "(Mathlib `Subgroup`)",
    ofG phrase!"number of normal subgroups of $v$" 10 "(Mathlib `Subgroup.Normal`)",
    ofG phrase!"number of conjugacy classes of $v$" 11 "(Mathlib `ConjClasses`)",
    ofG phrase!"order of the centre of $v$" 14 "(Mathlib `Subgroup.center`)",
    ofG phrase!"order of the center of $v$" 14 "(Mathlib `Subgroup.center`)",
    { name := phrase!"number of elements of order $v$ in $v$", value := .const 12, ty := .real ⟶ G ⟶ .real,
      doms := [some posInt, none], doc := "(Mathlib `orderOf`)" },
    { name := phrase!"number of Sylow $v$-subgroups of $v$", value := .const 13, ty := .real ⟶ G ⟶ .real,
      doms := [some posInt, none], doc := "for a prime `p` (Mathlib `Sylow`)" },
    onN phrase!"cyclic group of order $v$" 15 posInt "`C_n` (Mathlib `Multiplicative (ZMod n)`)",
    onN phrase!"symmetric group of degree $v$" 16 nonnegInt "`S_n` (Mathlib `Equiv.Perm (Fin n)`)",
    onN phrase!"alternating group of degree $v$" 17 nonnegInt "`A_n` (Mathlib `alternatingGroup`)",
    onN phrase!"dihedral group of order $v$" 18 (predR fun m => and (lt (num 0) m) (exInt fun k => eq m (mul (num 2) k)))
      "of even order `2n`: the symmetries of the regular `n`-gon (Mathlib `DihedralGroup n`)",
    { name := phrase!"Klein four-group", value := .const 19, ty := G, doc := "`C_2 × C_2`" },
    { name := phrase!"trivial group", value := .const 20, ty := G, doc := "of order 1" },
    { name := phrase!"direct product of $v$ and $v$", value := .const 21, ty := G ⟶ G ⟶ G, doc := "`G × H` (Mathlib `Prod`)" }]

end Leanify.Groups
