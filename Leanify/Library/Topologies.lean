import Leanify.Library.Core

/-! # Vocabulary: topologies on the real line

General topology on the set `ℝ`: a topology is a family of sets of real numbers, so that an
article compares the usual topology with the discrete, cofinite or lower limit topology,
asks which sets are open, compact or dense in each, and which maps are continuous between
them (`Let $\tau$ be a topology on $\mathbb{R}$.`, `$U$ is $\tau$-open`, `$f$ is continuous
from $\tau$ to $\sigma$`).

* nouns: `topology on $\mathbb{R}$` (contains `ℝ`, closed under finite intersections and
  arbitrary unions; the empty set is the union of no sets);
* adjectives of topologies: `Hausdorff`, `discrete`, `indiscrete`, `compact`, `connected`,
  `second countable`, `separable`, `metrizable`, `finer than $\sigma$`, `coarser than
  $\sigma$`, `strictly finer than $\sigma$`;
* adjectives of sets, with the topology: `$\tau$-open`, `$\tau$-closed`, `$\tau$-clopen`,
  `$\tau$-compact`, `$\tau$-connected`, `$\tau$-dense`, and after the set `open in $\tau$`,
  `closed in $\tau$`, `compact in $\tau$`, `connected in $\tau$`, `dense in $\tau$`;
* adjectives of points: `limit point of $U$ in $\tau$`, `isolated point of $U$ in $\tau$`,
  `interior point of $U$ in $\tau$`;
* adjectives of real functions, with two topologies: `continuous from $\tau$ to $\sigma$`,
  `open from $\tau$ to $\sigma$`, `homeomorphism from $\tau$ to $\sigma$`; of sequences
  (functions of the natural numbers): `convergent to $l$ in $\tau$`, `convergent in $\tau$`;
* notions: the usual (standard, Euclidean), discrete, indiscrete, cofinite and lower limit
  topologies on `ℝ`, the topology generated by a family of sets, the subspace topology,
  and the closure, interior and boundary of a set in a topology.

The open sets, the comparisons of topologies and the named topologies are terms of the
core language. Compactness, connectedness, density, the separation and countability
properties, continuity, closure and interior are Mathlib's, for the topological space
`Leanify.Topologies.space τ` that has the open sets of `τ`
(`Leanify/Library/TopologiesModel.lean`). -/

namespace Leanify.Topologies
open Build Core

/-- Sets of real numbers. -/
abbrev S : Ty := .real ⟶ .prop
/-- Families of sets of real numbers: topologies. -/
abbrev T : Ty := S ⟶ .prop
abbrev F : Ty := Ty.rfun

/-- The constants, in the order of their indices: `(type, TeX name, Lean name)`. -/
def table : List (Ty × Codes × Codes) := [
  (T ⟶ S ⟶ .prop, w!"\\operatorname{Compact}", w!"Leanify.Topologies.CompactIn"),          -- 0
  (T ⟶ S ⟶ .prop, w!"\\operatorname{Connected}", w!"Leanify.Topologies.ConnectedIn"),      -- 1
  (T ⟶ S ⟶ .prop, w!"\\operatorname{Dense}", w!"Leanify.Topologies.DenseIn"),              -- 2
  (T ⟶ .prop, w!"\\operatorname{T_2}", w!"Leanify.Topologies.Hausdorff"),                  -- 3
  (T ⟶ .prop, w!"\\operatorname{SecondCountable}", w!"Leanify.Topologies.SecondCountable"), -- 4
  (T ⟶ .prop, w!"\\operatorname{Separable}", w!"Leanify.Topologies.Separable"),            -- 5
  (T ⟶ .prop, w!"\\operatorname{Metrizable}", w!"Leanify.Topologies.Metrizable"),          -- 6
  (T ⟶ .prop, w!"\\operatorname{CompactSpace}", w!"Leanify.Topologies.CompactSpaceOf"),    -- 7
  (T ⟶ .prop, w!"\\operatorname{ConnectedSpace}", w!"Leanify.Topologies.ConnectedSpaceOf"), -- 8
  (T ⟶ T ⟶ F ⟶ .prop, w!"\\operatorname{Continuous}", w!"Leanify.Topologies.ContinuousFor"), -- 9
  (T ⟶ S ⟶ S, w!"\\operatorname{cl}", w!"Leanify.Topologies.closureIn"),                   -- 10
  (T ⟶ S ⟶ S, w!"\\operatorname{int}", w!"Leanify.Topologies.interiorIn"),                 -- 11
  (T ⟶ F ⟶ .real ⟶ .prop, w!"\\operatorname{Lim}", w!"Leanify.Topologies.ConvergesIn")]    -- 12

def c1 (i : Nat) (a : B) : B := app (const i) a
def c2 (i : Nat) (a b : B) : B := app2 (const i) a b
def c3 (i : Nat) (a b c : B) : B := app (app2 (const i) a b) c

/-- `τ` is a topology: it has `ℝ`, and the intersection of two and the union of any of its
sets. -/
def isTop (τ : B) : B :=
  and (app τ (lamR fun _ => tt))
    (and (allT S fun u => allT S fun v => imp (and (app τ u) (app τ v)) (app τ (lamR fun x => and (app u x) (app v x))))
      (allT T fun fam => imp (allT S fun u => imp (app fam u) (app τ u))
        (app τ (lamR fun x => exT S fun u => and (app fam u) (app u x)))))
def compl (u : B) : B := lamR fun x => not (app u x)
def isOpen (τ u : B) : B := app τ u
def isClosed (τ u : B) : B := app τ (compl u)
/-- `σ ⊆ τ`: every `σ`-open set is `τ`-open. -/
def finer (τ σ : B) : B := allT S fun u => imp (app σ u) (app τ u)
/-- `x` is in the `τ`-open set `u`. -/
def nbhd (τ u x : B) : B := and (app τ u) (app u x)
def image (f u : B) : B := lamR fun y => exR fun x => and (app u x) (eq (app f x) y)
def bijective (f : B) : B :=
  and (allR fun x => allR fun y => imp (eq (app f x) (app f y)) (eq x y)) (allR fun y => exR fun x => eq (app f x) y)

/-- The usual topology: every point of `U` has an interval around it in `U`. -/
def usual : B := lamT S (fun _ => tt) fun u => allR fun x => imp (app u x)
  (exR fun e => and (lt (num 0) e) (allR fun y => imp (lt (abs (sub y x)) e) (app u y)))
/-- The lower limit topology (Sorgenfrey line): intervals `[x, x+ε)`. -/
def lowerLimit : B := lamT S (fun _ => tt) fun u => allR fun x => imp (app u x)
  (exR fun e => and (lt (num 0) e) (allR fun y => imp (and (le x y) (lt y (add x e))) (app u y)))
/-- `U` is empty or its complement is finite (in the values of a function on `{0,…,n-1}`). -/
def cofinite : B := lamT S (fun _ => tt) fun u =>
  or (allR fun x => not (app u x))
    (exR fun n => exT F fun g => allR fun x => imp (not (app u x))
      (exR fun k => and (and (isNat k) (lt k n)) (eq (app g k) x)))

def setPred (body : B → B → B) : Tm := close <| lamT T (fun _ => tt) fun τ => lamT S (fun _ => tt) fun u => body τ u
def topPred (body : B → B) : Tm := close <| lamT T (fun _ => tt) body
def preS (p : Phrase) (body : B → B → B) (doc : String) : Modifier :=
  { phrase := p, prenominal := true, ty := S, pred := setPred body, doc }
def postS (p : Phrase) (body : B → B → B) (doc : String) : Modifier :=
  { phrase := p, prenominal := false, ty := S, pred := setPred body, doc }
def adjT (p : Phrase) (pre : Bool) (body : B → B) (doc : String) : Modifier :=
  { phrase := p, prenominal := pre, ty := T, pred := topPred body, doc }
/-- A comparison of the topology (the subject) with another (`P σ τ`). -/
def cmpT (p : Phrase) (body : B → B → B) (doc : String) : Modifier :=
  { phrase := p, prenominal := false, ty := T, doc,
    pred := close <| lamT T (fun _ => tt) fun σ => lamT T (fun _ => tt) fun τ => body τ σ }
/-- A property of a point `x` with a set and a topology (`P u τ x`). -/
def ptP (p : Phrase) (body : B → B → B → B) (doc : String) : Modifier :=
  { phrase := p, prenominal := false, ty := .real, doc,
    pred := close <| lamT S (fun _ => tt) fun u => lamT T (fun _ => tt) fun τ => lamR fun x => body τ u x }
/-- A property of a real function with two topologies (`P τ σ f`). -/
def mapP (p : Phrase) (body : B → B → B → B) (doc : String) : Modifier :=
  { phrase := p, prenominal := false, ty := F, doc,
    pred := close <| lamT T (fun _ => tt) fun τ => lamT T (fun _ => tt) fun σ => lamT F (fun _ => tt) fun f => body τ σ f }
def namedT (name : Phrase) (value : B) (doc : String) : Notion :=
  { name, ty := T, doc, value := close value }
def ofSetIn (name : Phrase) (body : B → B → B) (doc : String) : Notion :=
  { name, ty := S ⟶ T ⟶ S, doc, value := close <| lamT S (fun _ => tt) fun u => lamT T (fun _ => tt) fun τ => body u τ }

def isLimitPt (τ u x : B) : B :=
  allT S fun v => imp (nbhd τ v x) (exR fun y => and (and (app v y) (app u y)) (ne y x))

def vocab : Vocab where
  consts := table.map (·.1)
  constNames := table.map (·.2.1)
  constLean := table.map (·.2.2)
  modules := [w!"Leanify.Library.TopologiesModel"]
  nouns := [
    { sing := phrase!"topology $v$ on $\\mathbb{R}$", plural := phrase!"topologies $v$ on $\\mathbb{R}$", ty := T,
      pred := topPred isTop,
      doc := "a family of sets of real numbers with `ℝ`, finite intersections and arbitrary unions (Mathlib `TopologicalSpace ℝ`)" },
    { sing := phrase!"topology on $\\mathbb{R}$", plural := phrase!"topologies on $\\mathbb{R}$", ty := T,
      pred := topPred isTop, doc := "(after `is`: `$\\tau$ is a topology on $\\mathbb{R}$`)" },
    { sing := phrase!"topology", plural := phrase!"topologies", ty := T, pred := topPred isTop,
      doc := "a topology on `ℝ`" }]
  mods := [
    preS phrase!"$v$-open" isOpen "`U ∈ τ` (Mathlib `IsOpen`)",
    preS phrase!"$v$-closed" isClosed "`ℝ ∖ U ∈ τ` (Mathlib `IsClosed`)",
    preS phrase!"$v$-clopen" (fun τ u => and (isOpen τ u) (isClosed τ u)) "open and closed (Mathlib `IsClopen`)",
    preS phrase!"$v$-compact" (c2 0) "every open cover has a finite subcover (Mathlib `IsCompact`)",
    preS phrase!"$v$-connected" (c2 1) "nonempty and not the union of two disjoint relatively open sets (Mathlib `IsConnected`)",
    preS phrase!"$v$-dense" (c2 2) "its closure is `ℝ` (Mathlib `Dense`)",
    postS phrase!"open in $v$" isOpen "`U ∈ τ`",
    postS phrase!"closed in $v$" isClosed "`ℝ ∖ U ∈ τ`",
    postS phrase!"compact in $v$" (c2 0) "(Mathlib `IsCompact`)",
    postS phrase!"connected in $v$" (c2 1) "(Mathlib `IsConnected`)",
    postS phrase!"dense in $v$" (c2 2) "(Mathlib `Dense`)",
    adjT phrase!"Hausdorff" true (c1 3) "two distinct points have disjoint neighbourhoods (Mathlib `T2Space`)",
    adjT phrase!"discrete" true (fun τ => allT S fun u => app τ u) "every set is open (Mathlib `DiscreteTopology`)",
    adjT phrase!"indiscrete" true (fun τ => allT S fun u => imp (app τ u) (or (allR fun x => not (app u x)) (allR fun x => app u x)))
      "only `∅` and `ℝ` are open",
    adjT phrase!"compact" true (c1 7) "`ℝ` is compact for `τ` (Mathlib `CompactSpace`)",
    adjT phrase!"connected" true (c1 8) "`ℝ` is connected for `τ` (Mathlib `ConnectedSpace`)",
    adjT phrase!"second countable" true (c1 4) "with a countable basis (Mathlib `SecondCountableTopology`)",
    adjT phrase!"second-countable" true (c1 4) "(Mathlib `SecondCountableTopology`)",
    adjT phrase!"separable" true (c1 5) "with a countable dense set (Mathlib `SeparableSpace`)",
    adjT phrase!"metrizable" true (c1 6) "induced by a metric (Mathlib `MetrizableSpace`)",
    cmpT phrase!"finer than $v$" finer "every `σ`-open set is `τ`-open",
    cmpT phrase!"coarser than $v$" (fun τ σ => finer σ τ) "every `τ`-open set is `σ`-open",
    cmpT phrase!"strictly finer than $v$" (fun τ σ => and (finer τ σ) (not (finer σ τ))) "finer, and not the same",
    ptP phrase!"limit point of $v$ in $v$" isLimitPt "every open set around `x` meets `U` outside `x` (Mathlib `AccPt`)",
    ptP phrase!"isolated point of $v$ in $v$" (fun τ u x => and (app u x) (exT S fun v => and (nbhd τ v x)
        (allR fun y => imp (and (app v y) (app u y)) (eq y x))))
      "`x ∈ U` and some open set meets `U` only in `x`",
    ptP phrase!"interior point of $v$ in $v$" (fun τ u x => exT S fun v => and (nbhd τ v x) (allR fun y => imp (app v y) (app u y)))
      "some open set around `x` lies in `U` (Mathlib `interior`)",
    mapP phrase!"continuous from $v$ to $v$" (c3 9) "preimages of `σ`-open sets are `τ`-open (Mathlib `Continuous`)",
    mapP phrase!"open from $v$ to $v$" (fun τ σ f => allT S fun u => imp (app τ u) (app σ (image f u)))
      "images of `τ`-open sets are `σ`-open (Mathlib `IsOpenMap`)",
    mapP phrase!"homeomorphism from $v$ to $v$"
      (fun τ σ f => and (bijective f) (and (c3 9 τ σ f) (allT S fun u => imp (app τ u) (app σ (image f u)))))
      "bijective, continuous and open (Mathlib `Homeomorph`)",
    { phrase := phrase!"convergent to $v$ in $v$", prenominal := false, ty := F,
      doc := "`a_n → l` for `τ`, `n ∈ ℕ` (Mathlib `Filter.Tendsto … (nhds l)`)",
      pred := close <| lamR fun l => lamT T (fun _ => tt) fun τ => lamT F (fun _ => tt) fun a => c3 12 τ a l },
    { phrase := phrase!"convergent in $v$", prenominal := false, ty := F,
      doc := "`a_n → l` for `τ`, for some `l`",
      pred := close <| lamT T (fun _ => tt) fun τ => lamT F (fun _ => tt) fun a => exR fun l => c3 12 τ a l }]
  notions := [
    namedT phrase!"usual topology on $\\mathbb{R}$" usual "the sets with an interval around each of their points (Mathlib `UniformSpace.toTopologicalSpace`)",
    namedT phrase!"standard topology on $\\mathbb{R}$" usual "the usual topology",
    namedT phrase!"Euclidean topology on $\\mathbb{R}$" usual "the usual topology",
    namedT phrase!"discrete topology on $\\mathbb{R}$" (lamT S (fun _ => tt) fun _ => tt) "every set (Mathlib `⊥`)",
    namedT phrase!"indiscrete topology on $\\mathbb{R}$"
      (lamT S (fun _ => tt) fun u => or (allR fun x => not (app u x)) (allR fun x => app u x)) "`∅` and `ℝ` (Mathlib `⊤`)",
    namedT phrase!"trivial topology on $\\mathbb{R}$"
      (lamT S (fun _ => tt) fun u => or (allR fun x => not (app u x)) (allR fun x => app u x)) "the indiscrete topology",
    namedT phrase!"cofinite topology on $\\mathbb{R}$" cofinite "`∅` and the sets with a finite complement (Mathlib `CofiniteTopology`)",
    namedT phrase!"lower limit topology on $\\mathbb{R}$" lowerLimit "generated by the intervals `[a, b)` (the Sorgenfrey line)",
    { name := phrase!"topology generated by $v$", ty := T ⟶ T, doc := "the coarsest topology in which the sets of `B` are open (Mathlib `TopologicalSpace.generateFrom`)",
      value := close <| lamT T (fun _ => tt) fun b => lamT S (fun _ => tt) fun u =>
        allT T fun σ => imp (and (isTop σ) (allT S fun v => imp (app b v) (app σ v))) (app σ u) },
    { name := phrase!"subspace topology on $v$ induced by $v$", ty := S ⟶ T ⟶ T,
      doc := "the sets `U ∩ A` with `U` open, as sets of real numbers (Mathlib `TopologicalSpace.induced`)",
      value := close <| lamT S (fun _ => tt) fun a => lamT T (fun _ => tt) fun τ => lamT S (fun _ => tt) fun w =>
        exT S fun u => and (app τ u) (allR fun x => iff (app w x) (and (app u x) (app a x))) },
    ofSetIn phrase!"closure of $v$ in $v$" (fun u τ => c2 10 τ u) "the least `τ`-closed set containing `U` (Mathlib `closure`)",
    ofSetIn phrase!"interior of $v$ in $v$" (fun u τ => c2 11 τ u) "the largest `τ`-open set in `U` (Mathlib `interior`)",
    ofSetIn phrase!"boundary of $v$ in $v$" (fun u τ => lamR fun x => and (app (c2 10 τ u) x) (not (app (c2 11 τ u) x)))
      "the closure without the interior (Mathlib `frontier`)"]

end Leanify.Topologies
