import Leanify.Library.Core

/-! # Vocabulary: Diophantine equations

Linear and quadratic equations in integers (`We write $g(a,b)$ for the Frobenius number of $a$
and $b$.`, `$n$ is a congruent number`).

* nouns and modifiers: `congruent number` (a positive integer that is the area of a right
  triangle with rational sides); `representable as a sum of two squares` (a natural number
  `a² + b²` with integers `a`, `b`).
* notions: the Frobenius number `ab - a - b` of coprime `a, b ≥ 2` (the largest integer that is
  not `ax + by` with natural numbers `x`, `y`) and the genus `(a-1)(b-1)/2` of the numerical
  semigroup they generate (the number of such integers); the number of representations of `n`
  by `a` and `b` (pairs of natural numbers with `ax + by = n`); the number `r₂(n)` of
  representations of `n` as a sum of two squares (pairs of integers, with order and signs);
  the legs `m² - n²`, `2mn` and the hypotenuse `m² + n²` of the Pythagorean triple generated by
  integers `m > n ≥ 1` (Euclid's formula).

Every meaning is a term of the core language. -/

namespace Leanify.Diophantine
open Build Core

def natP (n : B) : B := and (isInt n) (le (num 0) n)
def posInt (n : B) : B := and (isInt n) (le (num 1) n)
def ge2 (n : B) : B := and (isInt n) (le (num 2) n)
def finSum (a b : B) (body : B → B) : B := app (app (app (prim .finSum) a) b) (lamR body)
def coprime (a b : B) : B :=
  allInt fun d => imp (and (divides d a) (divides d b)) (or (eq d (num 1)) (eq d (neg (num 1))))
def isRat (x : B) : B := exInt fun p => exInt fun q => and (lt (num 0) q) (eq (mul x q) p)
def sq (x : B) : B := mul x x
def congruent : Tm := predR fun n => and (posInt n) (exR fun a => exR fun b => exR fun c =>
  and (and (and (isRat a) (isRat b)) (and (isRat c) (and (lt (num 0) a) (lt (num 0) b))))
    (and (eq (add (sq a) (sq b)) (sq c)) (eq (div (mul a b) (num 2)) n)))
def twoSquares : Tm := predR fun n => and (natP n) (exInt fun a => exInt fun b => eq (add (sq a) (sq b)) n)
def semigroup (name : Phrase) (body : B → B → B) (doc : String) : Notion :=
  { name, ty := .real ⟶ .real ⟶ .real, doms := [dom1 .real ge2, dom2 .real fun a b => and (ge2 b) (coprime a b)], doc,
    value := close <| lamT .real ge2 fun a => lamT .real (fun b => and (ge2 b) (coprime a b)) fun b => body a b }
def euclid (name : Phrase) (body : B → B → B) (doc : String) : Notion :=
  { name, ty := .real ⟶ .real ⟶ .real, doms := [dom1 .real posInt, dom2 .real fun m n => and (posInt n) (lt n m)], doc,
    value := close <| lamT .real posInt fun m => lamT .real (fun n => and (posInt n) (lt n m)) fun n => body m n }

def vocab : Vocab where
  nouns := [
    noun phrase!"congruent number" phrase!"congruent numbers" congruent
      "a positive integer that is the area of a right triangle with rational sides"]
  mods := [
    { phrase := phrase!"representable as a sum of two squares", prenominal := false, ty := .real, pred := twoSquares,
      doc := "a natural number `a² + b²` with integers `a` and `b`" },
    { phrase := phrase!"congruent number", prenominal := false, ty := .real, pred := congruent,
      doc := "a positive integer that is the area of a right triangle with rational sides" }]
  notions := [
    semigroup phrase!"Frobenius number of $v$ and $v$" (fun a b => sub (sub (mul a b) a) b)
      "`ab - a - b`, for coprime `a, b ≥ 2`: the largest integer that is not `ax + by` with natural numbers `x`, `y` (Sylvester)",
    semigroup phrase!"genus of the numerical semigroup generated by $v$ and $v$" (fun a b => div (mul (sub a (num 1)) (sub b (num 1))) (num 2))
      "`(a-1)(b-1)/2`, for coprime `a, b ≥ 2`: the number of natural numbers that are not `ax + by` with natural numbers `x`, `y`",
    { name := phrase!"number of representations of $v$ by $v$ and $v$", ty := .real ⟶ .real ⟶ .real ⟶ .real,
      doms := [dom1 .real natP, dom2 .real fun _ a => posInt a, dom3 .real fun _ _ b => posInt b],
      doc := "the number of pairs `(x, y)` of natural numbers with `ax + by = n`",
      value := close <| lamT .real natP fun n => lamT .real posInt fun a => lamT .real posInt fun b =>
        finSum (num 0) n fun x => finSum (num 0) n fun y => cases (eq (add (mul a x) (mul b y)) n) (num 1) (num 0) },
    { name := phrase!"number of representations of $v$ as a sum of two squares", ty := .real ⟶ .real, doms := [dom1 .real natP],
      doc := "`r₂(n)`: the number of pairs `(a, b)` of integers with `a² + b² = n`",
      value := close <| lamT .real natP fun n =>
        finSum (neg n) n fun a => finSum (neg n) n fun b => cases (eq (add (sq a) (sq b)) n) (num 1) (num 0) },
    euclid phrase!"first leg of the Pythagorean triple generated by $v$ and $v$" (fun m n => sub (sq m) (sq n)) "`m² - n²` (Euclid's formula)",
    euclid phrase!"second leg of the Pythagorean triple generated by $v$ and $v$" (fun m n => mul (num 2) (mul m n)) "`2mn` (Euclid's formula)",
    euclid phrase!"hypotenuse of the Pythagorean triple generated by $v$ and $v$" (fun m n => add (sq m) (sq n)) "`m² + n²` (Euclid's formula)"]

end Leanify.Diophantine
