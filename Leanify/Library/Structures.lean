    noun phrase!"finite group" phrase!"finite groups" (sP fun g => and (app (const 11) g) (app (const 21) g)) "(Mathlib `Group`, `Finite`)",
    noun phrase!"abelian group" phrase!"abelian groups" (sP fun g => and (app (const 11) g) (app (const 12) g)) "(Mathlib `CommGroup`)",
